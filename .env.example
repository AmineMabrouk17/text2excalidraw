# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV (npm start / npm run dev)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in as needed. `.env` is git-ignored.
# The only variable the browser reads is VITE_OLLAMA_BASE_URL (not a secret).
#
# VITE_GEMINI_API_KEY / VITE_GROQ_API_KEY / VITE_OPENROUTER_API_KEY are GONE
# on purpose: anything prefixed VITE_ is bundled into the page and can be read
# by any visitor, so it can never hold shared/protected keys.

VITE_OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION SHARED KEYS (users use them, but can't see or retrieve them)
# ─────────────────────────────────────────────────────────────────────────────
# These are read ONLY by the /api/generate Vercel serverless function and
# never ship to the browser. Add them with the Vercel CLI (they're stored as
# encrypted project secrets, not in this file):
#
#   vercel env add SERVER_GEMINI_API_KEY production
#   vercel env add SERVER_GROQ_API_KEY production
#   vercel env add SERVER_OPENROUTER_API_KEY production
#
# (repeat with `preview` / `development` if you want them for vercel dev)
# Copy this file to `.env` and fill in your own keys. `.env` is git-ignored.
# All variables are OPTIONAL. The app pre-fills the matching key field with
# these values; anything you type in the UI is stored only in localStorage.
# Never paste a key into .env that you intend to commit — keep .env local.

VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_OLLAMA_BASE_URL=http://localhost:11434
